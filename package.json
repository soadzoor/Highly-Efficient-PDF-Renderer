{
  "name": "@soadzoor/hepr",
  "version": "0.1.19",
  "description": "Highly-Efficient-PDF-Renderer is a GPU-first PDF renderer for large technical documents, floorplans, books, and more, using the latest technologies and various tricks to achieve high performance and visual fidelity.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://soadzoor.github.io/Highly-Efficient-PDF-Renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soadzoor/Highly-Efficient-PDF-Renderer.git"
  },
  "bugs": {
    "url": "https://github.com/soadzoor/Highly-Efficient-PDF-Renderer/issues"
  },
  "keywords": [
    "pdf",
    "renderer",
    "three",
    "threejs",
    "webgl",
    "webgpu",
    "floorplan",
    "vector"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./three": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --mode lib",
    "build:all": "npm run build && npm run build:lib",
    "release-new-version": "npm run build:all && npm version patch && git push --follow-tags",
    "pack:local": "npm run build:lib && npm pack",
    "publish:dry-run": "npm publish --access public --dry-run",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "generate-manifest": "node --max-old-space-size=12288 --experimental-strip-types scripts/generate-manifest.ts",
    "test:example-assets": "node --experimental-strip-types scripts/test-example-assets.mjs",
    "test:ordered-gradient": "node --experimental-strip-types scripts/test-ordered-gradient-paint.mjs",
    "test:pdf-cancel": "node scripts/test-pdf-source-cancellation.mjs",
    "test:raster-archive": "node scripts/test-raster-image-zip.mjs",
    "test:raster-ownership": "node scripts/test-raster-texture-ownership.mjs",
    "test:text-glyph-coverage": "node scripts/test-text-glyph-coverage.mjs",
    "test:text-lod-core": "node --experimental-strip-types scripts/test-text-lod-core.mjs",
    "test:text-lod-native": "node scripts/test-native-text-lod.mjs",
    "test:text-lod-three": "node scripts/test-three-text-lod.mjs",
    "test:deferred-renderer": "node --experimental-strip-types scripts/test-deferred-renderer-api.mjs",
    "test:three-color": "node scripts/test-three-color-parity.mjs",
    "test:three-performance": "node scripts/test-three-instance-buffer-updates.mjs",
    "test:parsed-zip": "node scripts/test-parsed-data-zip.mjs",
    "test:parsed-zip:package": "npm run build:lib && node scripts/test-parsed-data-zip-package.mjs",
    "test:rooms": "node scripts/test-room-detector.mjs",
    "score:rooms": "node scripts/score-rooms.mjs",
    "audit:rooms": "node scripts/audit-room-topology.mjs",
    "gold:rooms": "node scripts/room-gold-set.mjs",
    "prepublishOnly": "npm run build:all"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
