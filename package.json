{
  "name": "@soadzoor/hepr",
  "version": "0.1.5",
  "description": "Highly-Efficient-PDF-Renderer is a GPU-first PDF renderer for large technical documents, floorplans, books, and more, using the latest technologies and various tricks to achieve high performance and visual fidelity.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://soadzoor.github.io/Highly-Efficient-PDF-Renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soadzoor/Highly-Efficient-PDF-Renderer.git"
  },
  "bugs": {
    "url": "https://github.com/soadzoor/Highly-Efficient-PDF-Renderer/issues"
  },
  "keywords": [
    "pdf",
    "renderer",
    "three",
    "threejs",
    "webgl",
    "webgpu",
    "floorplan",
    "vector"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./three": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:app": "tsc && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --mode lib",
    "build:all": "npm run build:app && npm run build:lib",
    "pack:local": "npm run build:lib && npm pack",
    "publish:dry-run": "npm publish --access public --dry-run",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "generate-manifest": "node --max-old-space-size=12288 --experimental-strip-types scripts/generate-manifest.ts",
    "prepublishOnly": "npm run build:all"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdfjs-dist": "6.0.227"
  },
  "devDependencies": {
    "@types/three": "0.184.1",
    "three": "0.184.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
